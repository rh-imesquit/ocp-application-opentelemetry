# MinIO Community Edition - source build
#
# Community MinIO is source-only. This image compiles fixed MinIO and mc
# releases and uses Red Hat UBI 9 for both build and runtime stages.
#
# Build example:
#   podman build \
#     -f infra/minio/image/Containerfile \
#     -t quay.io/<namespace>/minio-community:RELEASE.2025-10-15T17-29-55Z \
#     infra/minio/image

ARG MINIO_VERSION=RELEASE.2025-10-15T17-29-55Z
ARG MC_VERSION=RELEASE.2025-08-13T08-35-41Z

FROM registry.access.redhat.com/ubi9/go-toolset:1.24 AS builder

ARG MINIO_VERSION
ARG MC_VERSION

USER 0

RUN dnf install -y git \
    && dnf clean all \
    && rm -rf /var/cache/dnf

RUN mkdir -p /tmp/bin \
    && chown -R 1001:0 /tmp/bin

USER 1001

ENV GOBIN=/tmp/bin

RUN go install -v "github.com/minio/minio@${MINIO_VERSION}" \
    && go install -v "github.com/minio/mc@${MC_VERSION}" \
    && /tmp/bin/minio --version \
    && /tmp/bin/mc --version

FROM registry.access.redhat.com/ubi9/ubi-minimal:latest

LABEL org.opencontainers.image.title="MinIO Community Edition"
LABEL org.opencontainers.image.description="MinIO Community Edition and mc compiled from source on Red Hat UBI 9"
LABEL org.opencontainers.image.source="https://github.com/minio/minio"
LABEL org.opencontainers.image.licenses="AGPL-3.0"

ARG MINIO_VERSION
ARG MC_VERSION

LABEL org.opencontainers.image.version="${MINIO_VERSION}"
LABEL io.minio.mc.version="${MC_VERSION}"

USER 0

RUN microdnf install -y ca-certificates \
    && microdnf clean all \
    && mkdir -p /data /tmp/mc \
    && chgrp -R 0 /data /tmp/mc \
    && chmod -R g=u /data /tmp/mc

COPY --from=builder /tmp/bin/minio /usr/local/bin/minio
COPY --from=builder /tmp/bin/mc /usr/local/bin/mc

RUN chown root:0 /usr/local/bin/minio /usr/local/bin/mc \
    && chmod 0755 /usr/local/bin/minio /usr/local/bin/mc

# OpenShift may replace this UID with an arbitrary UID. The writable paths
# above are root-group writable to remain compatible with restricted SCC.
USER 1001

EXPOSE 9000 9001

ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
