FROM registry.access.redhat.com/ubi9/php-83:latest

ENV DOCUMENTROOT=/public \
    COMPOSER_ARGS="--no-dev --optimize-autoloader"

USER 0

# A auto-instrumentação PHP upstream requer a extensão nativa OpenTelemetry.
# A extensão é instalada via PECL conforme a documentação oficial do OpenTelemetry PHP.
RUN dnf install -y \
        autoconf \
        gcc \
        make \
        php-devel \
        php-pear \
    && pecl install opentelemetry \
    && echo "extension=opentelemetry.so" > /etc/php.d/99-opentelemetry.ini \
    && php --ri opentelemetry \
    && dnf remove -y \
        autoconf \
        gcc \
        make \
        php-devel \
        php-pear \
    && dnf clean all \
    && rm -rf /var/cache/dnf /tmp/pear

COPY --chown=1001:0 . /tmp/src

USER 1001

RUN /usr/libexec/s2i/assemble \
    && php --ri opentelemetry \
    && php -r "require '/opt/app-root/src/vendor/autoload.php'; echo 'Composer autoload OK', PHP_EOL;"

EXPOSE 8080

CMD ["/usr/libexec/s2i/run"]