{
  "name": "lab/php-observability-demo",
  "description": "Aplicação PHP Slim de exemplo para laboratório de observabilidade no OpenShift",
  "type": "project",
  "require": {
    "php": "^8.3",
    "slim/slim": "^4.15",
    "slim/psr7": "^1.7",
    "open-telemetry/sdk": "^1.0",
    "open-telemetry/exporter-otlp": "^1.0",
    "open-telemetry/opentelemetry-auto-slim": "^1.5",
    "php-http/guzzle7-adapter": "^1.0"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    }
  }
}